
(rules PCB temp-freerouting.dsn
  (snap_angle 
    fortyfive_degree
  )
  (rule
    (width 250.0)
    (clearance 127.0)
    (clearance 125.0 (type smd_to_turn_gap))
    (clearance 31.8 (type smd))
    (clearance 127.0 (type "kicad_default"))
    (clearance 200.0 (type power5V))
  )
  (padstack "Via[0-1]_800:400_um"
    (shape
      (circle F.Cu 800.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 800.0 0.0 0.0)
    )
    (attach off)
  )
  (padstack "Via[0-1]_1200:700_um"
    (shape
      (circle F.Cu 1200.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 1200.0 0.0 0.0)
    )
    (attach off)
  )
  (padstack "Via[0-1]_900:500_um"
    (shape
      (circle F.Cu 900.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 900.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-1]_800:400_um" "Via[0-1]_800:400_um" default
  )
  (via 
    "Via[0-1]_1200:700_um" "Via[0-1]_1200:700_um" default
  )
  (via 
    "Via[0-1]_900:500_um" "Via[0-1]_900:500_um" default
  )
  (via 
    "Via[0-1]_800:400_um-kicad_default" "Via[0-1]_800:400_um" "kicad_default"
  )
  (via 
    "Via[0-1]_1200:700_um-kicad_default" "Via[0-1]_1200:700_um" "kicad_default"
  )
  (via 
    "Via[0-1]_900:500_um-kicad_default" "Via[0-1]_900:500_um" "kicad_default"
  )
  (via 
    "Via[0-1]_800:400_um-power5V" "Via[0-1]_800:400_um" power5V
  )
  (via 
    "Via[0-1]_1200:700_um-power5V" "Via[0-1]_1200:700_um" power5V
  )
  (via 
    "Via[0-1]_900:500_um-power5V" "Via[0-1]_900:500_um" power5V
  )
  (via 
    "Via[0-1]_800:400_um-power3V3" "Via[0-1]_800:400_um" power5V
  )
  (via 
    "Via[0-1]_1200:700_um-power3V3" "Via[0-1]_1200:700_um" power5V
  )
  (via 
    "Via[0-1]_900:500_um-power3V3" "Via[0-1]_900:500_um" power5V
  )
  (via 
    "Via[0-1]_800:400_um-power" "Via[0-1]_800:400_um" power5V
  )
  (via 
    "Via[0-1]_1200:700_um-power" "Via[0-1]_1200:700_um" power5V
  )
  (via 
    "Via[0-1]_900:500_um-power" "Via[0-1]_900:500_um" power5V
  )
  (via_rule
    default "Via[0-1]_800:400_um"
  )
  (via_rule
    "kicad_default" "Via[0-1]_800:400_um-kicad_default"
  )
  (via_rule
    power5V "Via[0-1]_1200:700_um-power5V"
  )
  (via_rule
    power3V3 "Via[0-1]_900:500_um-power3V3"
  )
  (via_rule
    power "Via[0-1]_1200:700_um-power"
  )
  (class default
    (clearance_class default)
    (via_rule default)
    (rule
      (width 250.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class "kicad_default"
    /RaspberryPi4/GPIO24 /RaspberryPi4/GPIO25 /RaspberryPi4/GPIO8 /RaspberryPi4/GPIO7 /RaspberryPi4/GPIO0 /RaspberryPi4/GPIO1 /RaspberryPi4/GPIO5 /RaspberryPi4/GPIO6
    /RaspberryPi4/GPIO12 GND /m48t59y/DQ7 /m48t59y/DQ6 /m48t59y/DQ5 /m48t59y/DQ3 /m48t59y/DQ4 /m48t59y/DQ2
    /m48t59y/DQ1 /m48t59y/DQ0 "Net-(D4-A)" /RaspberryPi4/SDA /RaspberryPi4/SCL /RaspberryPi4/GPIO4 /RaspberryPi4/GPIO14 /RaspberryPi4/GPIO15
    /RaspberryPi4/GPIO17 /RaspberryPi4/GPIO18 /RaspberryPi4/GPIO27 /RaspberryPi4/GPIO22 /RaspberryPi4/GPIO23 /RaspberryPi4/MOSI /RaspberryPi4/MISO /RaspberryPi4/SCLK
    /RaspberryPi4/GPIO13 /RaspberryPi4/GPIO19 /RaspberryPi4/GPIO16 /RaspberryPi4/GPIO26 /RaspberryPi4/GPIO20 /RaspberryPi4/GPIO21 /m48t59y/INT /m48t59y/Q2B
    /m48t59y/Q1A /m48t59y/Q1B /m48t59y/Q1C /m48t59y/Q1D /m48t59y/Q1E /m48t59y/Q1F /m48t59y/Q1G /m48t59y/Q1H
    /m48t59y/E1 /m48t59y/Q2D /m48t59y/G /m48t59y/Q2C /m48t59y/Q2E "Net-(U5-QA)" /m48t59y/E2 /m48t59y/W
    "unconnected-(J3-Pin_5-Pad5)" "unconnected-(J3-Pin_6-Pad6)" "/m48t59y/SER_IN" /m48t59y/SRCCLK /m48t59y/RCLK "Net-(D2-A)" "Net-(D1-A)" "unconnected-(U5-QF-Pad5)"
    "unconnected-(U5-QG-Pad6)" "unconnected-(U5-QH-Pad7)" "unconnected-(U5-QH'-Pad9)" "Net-(U4-QH')"
    (clearance_class "kicad_default")
    (via_rule "kicad_default")
    (rule
      (width 250.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class power5V
    +5V
    (clearance_class power5V)
    (via_rule power5V)
    (rule
      (width 762.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class power3V3
    +3V3
    (clearance_class power5V)
    (via_rule power3V3)
    (rule
      (width 508.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class power
    +12V
    (clearance_class power5V)
    (via_rule power)
    (rule
      (width 1270.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
)